+QuantFormat = Literal["nvfp4", "mxfp8"]
+PROJECTIONS = ("w13", "w2")
+POLICIES = ("source", "signed", "c1-down", "full-c1")
+CODA_C1_LAYER = 22
+CODA_C1_LAYERS = range(20, 24)
+CODA_C1_FIELDS = {
+    "packed": "weight",
+    "tags": "weight_scale",
+    "scales": "c1_row",
+    "table": "c1_table",
