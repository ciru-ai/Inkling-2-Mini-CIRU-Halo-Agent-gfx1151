+        float mv = m_s[(int64_t)m * sm_t];
+        float b  = (1.0f - tanhf(f)) * dv + tanhf(g) * mv;
+        int64_t row = (int64_t)s * M + m;
+        Blended[row * D + c] = b;
+        float sq = b * b;
+        #pragma unroll
+        for (int off = 16; off > 0; off >>= 1) sq += __shfl_xor(sq, off, 32);
+        if (lane == 0) PartSq[row * 72 + blk] = sq;
+    }
+}
