+                        fused_activation=fused_activation,
+                        out_fp16=allow_fp16,
+                    )
+                    if hip_out is not None:
+                        return hip_out
+            if x.dtype != torch.bfloat16:
+                x = x.to(torch.bfloat16)
+            if bank is not None:
