+        }
+
+        int sm_col = warp * 16 + lane16;
+        #pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            int t_loc = half + 2 * r;
+            smem_u.gf.G[t_loc][sm_col] = fast_tanh_hw(g_acc[r]);
