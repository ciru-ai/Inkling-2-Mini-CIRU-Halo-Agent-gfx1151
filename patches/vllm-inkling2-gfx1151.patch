+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Modified or added by Ciru for Inkling 2 Mini on AMD gfx1151.
+"""bf16 linears as the reference `linear`: fp32 accumulation in ordered
+1024-wide K groups."""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _k_group_tile(
+    X,
+    W,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    SPLIT: tl.constexpr,
+    pid_n,
+    pid_m,
+    pid_k,
+):
+    # With SPLIT, each program computes one K group's partial; otherwise it
+    # sums the groups in order.
+    cols = pid_n * BN + tl.arange(0, BN)
+    rows = pid_m * BM + tl.arange(0, BM)
+    ks = tl.arange(0, 128)
+    first = pid_k if SPLIT else 0
+    NUM_GROUPS: tl.constexpr = 1 if SPLIT else (K + 1023) // 1024
+    total = tl.zeros((BM, BN), tl.float32)
+    for g in tl.static_range(NUM_GROUPS):
+        group = first + g
+        partial = tl.zeros((BM, BN), tl.float32)
+        for tile in range(8):
+            k = group * 1024 + tile * 128 + ks
+            x = tl.load(
+                X + rows[:, None] * K + k[None, :],
+                (rows[:, None] < M) & (k[None, :] < K),
+                other=0,
+            )
+            w = tl.load(
+                W + cols[None, :] * K + k[:, None],
+                (cols[None, :] < N) & (k[:, None] < K),
+                other=0,
+            )
+            partial = tl.dot(x, w, partial)
+        total = partial if g == 0 else total + partial
+    tl.store(
+        Y + (first * M + rows[:, None]) * N + cols[None, :],
+        total.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & (cols[None, :] < N),
+    )
+
+
+@triton.jit
+def _k_group_kernel(
+    X,
+    W,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    SPLIT: tl.constexpr,
+):
+    _k_group_tile(
+        X,
+        W,
+        Y,
+        M,
+        N,
+        K,
+        BM,
+        BN,
+        SPLIT,
+        tl.program_id(0),
+        tl.program_id(1),
+        tl.program_id(2),
+    )
+
+
+@triton.jit
+def _k_group_sum_kernel(Partials, Y, MN, GROUPS: tl.constexpr, BLOCK: tl.constexpr):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < MN
+    total = tl.load(Partials + offs, mask)
+    for group in range(1, GROUPS):
+        total = total + tl.load(Partials + group * MN + offs, mask)
+    tl.store(Y + offs, total, mask)
+
+
+def k_group_partials(
+    x: torch.Tensor, weight: torch.Tensor, out_dtype: torch.dtype = torch.float32
+) -> torch.Tensor:
+    """fp32 partials [G, T, N] of `x @ weight.T` whose in-order sum over G is
+    the reference `linear`. G is 1 (already summed, in `out_dtype`) when
+    there are enough rows to fill the GPU without splitting K."""
+    assert x.is_contiguous() and weight.is_contiguous()
+    tokens, hidden = x.shape
+    n = weight.shape[0]
+    block_m = 16 if tokens <= 128 else 64
+    block_n = 32 if tokens <= 16 else 64 if tokens <= 256 else 128
+    groups = triton.cdiv(hidden, 1024)
+    split = groups > 1 and tokens < 4096
+    out = torch.empty(
+        (groups if split else 1, tokens, n),
+        dtype=torch.float32 if split else out_dtype,
+        device=x.device,
+    )
+    grid = (
+        triton.cdiv(n, block_n),
+        triton.cdiv(tokens, block_m),
+        groups if split else 1,
+    )
+    _k_group_kernel[grid](
+        x,
+        weight,
+        out,
+        tokens,
+        n,
+        hidden,
+        block_m,
+        block_n,
+        split,
+        num_warps=4 if block_n <= 64 else 8,
+        # gfx950's 160 KB of LDS fits two stages of the largest tiles.
+        num_stages=2,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+def linear_k_groups(
+    x: torch.Tensor, weight: torch.Tensor, out_dtype: torch.dtype = torch.float32
+) -> torch.Tensor:
+    """`x @ weight.T` for bf16 `x` [T, K] and `weight` [N, K].
+
+    Each 1024-wide K group is accumulated in fp32 and the partials are summed in
+    order, as in the reference `linear`.
+    """
+    partials = k_group_partials(x, weight, out_dtype)
+    if partials.shape[0] == 1:
+        return partials[0]
+    out = torch.empty(partials.shape[1:], dtype=out_dtype, device=x.device)
+    _k_group_sum_kernel[(triton.cdiv(out.numel(), 1024),)](
+        partials, out, out.numel(), partials.shape[0], 1024
+    )
+    return out
diff --git a/vllm/models/inkling2/amd/ops/loop.py b/vllm/models/inkling2/amd/ops/loop.py
new file mode 100644
index 00000000..7f19f737
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/loop.py
@@ -0,0 +1,202 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Modified or added by Ciru for Inkling 2 Mini on AMD gfx1151.
+"""Portable reference math for Inkling 2 loop messages and block residuals."""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.hip import libdevice
+
+from .attn_res import fused_attn_res
+
+
+_PACKED_ATTN_RES = os.getenv("INKLING_AMD_PACKED_ATTN_RES") == "1"
+
+
+@triton.jit
+def _pair_rms_norm_kernel(
+    Dest,
+    Message,
+    Out,
+    stride_dest_s,
+    stride_dest_t,
+    stride_message_s,
+    stride_message_t,
+    tokens,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    stream = tl.program_id(1).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    dest = tl.load(
+        Dest + stream * stride_dest_s + token * stride_dest_t + cols, mask, other=0
+    )
+    message = tl.load(
+        Message + stream * stride_message_s + token * stride_message_t + cols,
+        mask,
+        other=0,
+    )
+    dest_rstd = libdevice.rsqrt(tl.div_rn(tl.sum(dest * dest), D) + 1e-6)
+    message_rstd = libdevice.rsqrt(
+        tl.div_rn(tl.sum(message * message), D) + 1e-6
+    )
+    out = Out + (stream * tokens + token) * (2 * D) + cols
+    tl.store(out, (dest * dest_rstd).to(tl.bfloat16), mask)
+    tl.store(out + D, (message * message_rstd).to(tl.bfloat16), mask)
+
+
+@triton.jit
+def _blend_rms_norm_kernel(
+    Dest,
+    Message,
+    GainForget,
+    NormWeight,
+    Out,
+    stride_dest_s,
+    stride_dest_t,
+    stride_message_s,
+    stride_message_t,
+    stride_weight_s,
+    tokens,
+    norm_eps,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    token = tl.program_id(0).to(tl.int64)
+    stream = tl.program_id(1).to(tl.int64)
+    row = stream * tokens + token
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    dest = tl.load(
+        Dest + stream * stride_dest_s + token * stride_dest_t + cols, mask, other=0
+    )
+    message = tl.load(
+        Message + stream * stride_message_s + token * stride_message_t + cols,
+        mask,
+        other=0,
+    )
+    gains = GainForget + row * (2 * D) + cols
+    gain = libdevice.tanh(tl.load(gains, mask, other=0))
+    forget = libdevice.tanh(tl.load(gains + D, mask, other=0))
+    blended = (1.0 - forget) * dest + gain * message
+    rstd = libdevice.rsqrt(tl.div_rn(tl.sum(blended * blended), D) + norm_eps)
+    weight = tl.load(NormWeight + stream * stride_weight_s + cols, mask, other=0)
+    normalized = blended * rstd * weight.to(tl.float32)
+    tl.store(Out + row * D + cols, normalized.to(tl.bfloat16), mask)
+
+
+def _packed_rows(dest: torch.Tensor, message: torch.Tensor) -> bool:
+    # AttnRes einsum returns token-major views for multi-token batches.
+    # Only channels must be contiguous, and destination streams may broadcast.
+    return (
+        dest.is_cuda
+        and dest.device == message.device
+        and dest.shape == message.shape
+        and message.ndim == 3
+        and message.shape[0] in (1, 3)
+        and message.shape[2] == 2304
+        and dest.dtype == message.dtype == torch.float32
+        and dest.stride(-1) == message.stride(-1) == 1
+    )
+
+
+def _unit_rms(x: torch.Tensor, eps: float) -> torch.Tensor:
+    return x * torch.rsqrt(x.square().mean(dim=-1, keepdim=True) + eps)
+
+
+def pair_rms_norm(
+    dest: torch.Tensor, message: torch.Tensor, *, packed: bool = False
+) -> torch.Tensor:
+    if packed and _packed_rows(dest, message):
+        from .hip_runtime import hip_pair_rmsnorm
+
+        hip_out = hip_pair_rmsnorm(dest, message)
+        if hip_out is not None:
+            return hip_out
+        streams, tokens, width = message.shape
+        out = message.new_empty((streams, tokens, 2 * width), dtype=torch.bfloat16)
+        if tokens:
+            _pair_rms_norm_kernel[(tokens, streams)](
+                dest, message, out, *dest.stride()[:2], *message.stride()[:2],
+                tokens, D=width, BLOCK=4096, num_warps=4, enable_fp_fusion=False,
+            )
+        return out
+    return torch.cat(
+        (_unit_rms(dest, 1e-6), _unit_rms(message, 1e-6)), dim=-1
+    ).bfloat16()
+
+
+def blend_rms_norm(
+    dest: torch.Tensor,
+    message: torch.Tensor,
+    gain_forget: torch.Tensor,
+    norm_weight: torch.Tensor,
+    norm_eps: float,
+    *,
+    packed: bool = False,
+) -> torch.Tensor:
+    if packed and _packed_rows(dest, message):
+        streams, tokens, width = message.shape
+        if (
+            gain_forget.shape == (streams, tokens, 2 * width)
+            and gain_forget.dtype == torch.float32
+            and gain_forget.is_contiguous()
+            and gain_forget.device == dest.device
+            and norm_weight.shape == (streams, width)
+            and norm_weight.dtype in (torch.float32, torch.bfloat16)
+            and norm_weight.stride(-1) == 1
+            and norm_weight.device == dest.device
+        ):
+            from .hip_runtime import hip_blend_rmsnorm
+
+            hip_out = hip_blend_rmsnorm(dest, message, gain_forget, norm_weight, norm_eps)
+            if hip_out is not None:
+                return hip_out
+            out = message.new_empty(message.shape, dtype=torch.bfloat16)
+            if tokens:
+                _blend_rms_norm_kernel[(tokens, streams)](
+                    dest, message, gain_forget, norm_weight, out,
+                    *dest.stride()[:2], *message.stride()[:2], norm_weight.stride(0),
+                    tokens, norm_eps, D=width, BLOCK=4096, num_warps=4,
+                    enable_fp_fusion=False,
+                )
+            return out
+    gain, forget = gain_forget.tanh().chunk(2, dim=-1)
+    blended = (1.0 - forget) * dest + gain * message
+    return (_unit_rms(blended, norm_eps) * norm_weight[:, None]).bfloat16()
+
+
+def attn_res(
+    stack: torch.Tensor,
+    last: torch.Tensor,
+    addend: torch.Tensor | None,
+    queries: torch.Tensor,
+    norm_weight: torch.Tensor | None,
+    norm_eps: float,
+    normalize_values: bool,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Return FP32 mixes, or normalize and round at the BF16 boundary."""
+    if _PACKED_ATTN_RES and last.is_cuda:
+        fused = fused_attn_res(
+            stack, last, addend, queries, norm_weight, norm_eps, normalize_values, eps
+        )
+        if fused is not None:
+            return fused
+    tail = last.float()
+    if addend is not None:
+        tail = tail + addend.float()
+    sources = torch.cat((stack.float(), tail[None]), dim=0)
+    normalized = _unit_rms(sources, eps)
+    logits = torch.einsum("qd,std->qts", queries, normalized)
+    probs = logits.softmax(dim=-1)
+    values = normalized if normalize_values else sources
+    mixed = torch.einsum("qts,std->qtd", probs, values)
+    if norm_weight is None:
+        return mixed
+    return (_unit_rms(mixed, norm_eps) * norm_weight[:, None]).to(last.dtype)
