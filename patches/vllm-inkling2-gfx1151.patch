+                for (int b = 0; b < nb; ++b) mx = fmaxf(mx, sm_dot[qi][b]);
+                float sum_e = 0.0f;
+                for (int b = 0; b < nb; ++b) {
+                    float e = expf(sm_dot[qi][b] - mx);
+                    sm_ex[b] = e;
+                    sum_e += e;
+                }
+                float inv_e = 1.0f / sum_e;
+                for (int b = 0; b < nb; ++b) {
