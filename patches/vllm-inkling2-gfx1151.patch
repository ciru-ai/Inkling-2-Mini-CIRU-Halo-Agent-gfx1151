+        float g = 0.0f, f = 0.0f;
+        #pragma unroll
+        for (int u = 0; u < 32; ++u) {
+            uint32_t hv = smem_h[m][u];
+            asm("v_dot2_f32_bf16 %0, %1, %2, %0" : "+v"(g) : "v"(wg[u]), "v"(hv));
+            asm("v_dot2_f32_bf16 %0, %1, %2, %0" : "+v"(f) : "v"(wf[u]), "v"(hv));
+        }
