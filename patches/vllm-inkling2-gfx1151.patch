+        pack_bf16x2(bl[0] * rstd * nw[0], bl[1] * rstd * nw[1]),
+        pack_bf16x2(bl[2] * rstd * nw[2], bl[3] * rstd * nw[3]),
+        pack_bf16x2(bl[4] * rstd * nw[4], bl[5] * rstd * nw[5]),
