+def hip_flash_rel_attn_prefill(
+    q: torch.Tensor,
+    r: torch.Tensor,
+    rel_proj_t: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    gate: torch.Tensor,
+    sinks: torch.Tensor,
+    result: torch.Tensor,
+    *,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
