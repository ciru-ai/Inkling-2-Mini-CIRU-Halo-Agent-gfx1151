+        P2_STK(4, s4); P2_STK(5, s5); P2_STK(6, s6);  P2_STK(7, s7);
+        P2_STK(8, s8); P2_STK(9, s9); P2_STK(10, s10); P2_STK(11, s11);
+        #undef P2_STK
