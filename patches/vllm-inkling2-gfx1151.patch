+        }
+        __syncthreads();
+
+        if (ld_ok) {
+            float4 df0 = *reinterpret_cast<const float4*>(dest_row + k0 + ld_k);
+            float4 df1 = *reinterpret_cast<const float4*>(dest_row + k0 + ld_k + 4);
