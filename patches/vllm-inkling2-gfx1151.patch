+        or (q.stride(1) & 7) != 0
+        or (r.data_ptr() & 15) != 0
+        or (r.stride(0) & 7) != 0
+        or (r.stride(1) & 7) != 0
+        or (key_cache.data_ptr() & 15) != 0
+        or (value_cache.data_ptr() & 15) != 0
+        or key_cache.stride(3) != 1
+        or value_cache.stride(3) != 1
